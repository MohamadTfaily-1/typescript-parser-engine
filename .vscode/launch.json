{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug TypeScript",
      "program": "${workspaceFolder}/build/index.js",
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "console": "integratedTerminal",
      "autoAttachChildProcesses": false,
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}