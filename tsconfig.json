{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "types":["node","jest"],
    "rootDir": "./src",
    "outDir": "./build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap":true
    
  },
  "include": [
    "src/**/*"
, "jest.config.js"  ],
  "exclude": [
    "node_modules",
    "build",
    "jest.config.ts"
  ]
}